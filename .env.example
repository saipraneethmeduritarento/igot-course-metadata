# Copy to .env and fill in the values. Never commit .env; it is gitignored.
#
#   cp .env.example .env
#
# Every variable here is read by the code. All are required unless marked optional.

# -- Google Cloud / Vertex AI --------------------------------------------------
# Service-account JSON with the Vertex AI User role. The Google client library
# reads this variable itself.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
GOOGLE_PROJECT_ID=your-gcp-project-id
# gemini-3.1-pro-preview is served only from the "global" location; a regional
# location returns 404.
GOOGLE_PROJECT_LOCATION=global
GEMINI_PRO_MODEL_NAME=gemini-3.1-pro-preview

# -- LLM calls -----------------------------------------------------------------
LLM_TEMPERATURE=0.1
LLM_MAX_OUTPUT_TOKENS=32768
LLM_TIMEOUT_SECONDS_META=300   # timeout of one request, in seconds
MAX_ATTEMPTS=3                 # HTTP attempts per request (includes the first try)
MAX_CONCURRENCY=4              # requests in flight at the same time

# -- Database ------------------------------------------------------------------
# Plain libpq DSN. load_transcripts_to_postgres creates the database if it
# doesn't exist.
DB_DSN=postgresql://user:password@localhost:5432/karmayogi_db

# -- Karmayogi content API (course extraction) ---------------------------------
# Used to get each course's resources in learner order. Responses are cached in
# data/input/course_api/, so a cached course is never fetched again.
# The key may be given with or without the "Bearer " prefix.
KARMAYOGI_API_KEY=Bearer your-api-key
KARMAYOGI_BASE_URL=https://portal.igotkarmayogi.gov.in
API_REQUEST_TIMEOUT=30         # optional, seconds (default 30)
